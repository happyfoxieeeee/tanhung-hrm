# =====================================================================
# TAN HUNG HRM — biến môi trường (sao chép thành .env hoặc khai báo trên Vercel)
# KHÔNG đưa file .env có giá trị thật lên Git. Sinh secret: npm run secrets
# =====================================================================

# --- Bắt buộc ---
# Chuỗi kết nối PostgreSQL. Neon: dùng chuỗi "Pooled connection", có ?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Khóa bí mật ngẫu nhiên ≥ 32 ký tự (dùng để băm mã OTP). Đổi khóa sẽ làm mã OTP đang chờ mất hiệu lực.
APP_SECRET=
# Mã thiết lập mật khẩu lần đầu (≥ 24 ký tự, dùng một lần). Có thể xóa sau khi đã thiết lập xong.
INITIAL_SETUP_TOKEN=

# --- Email nhận mã OTP đổi mật khẩu ---
# Nếu đặt ở đây thì email này được cố định (không đổi được trên giao diện).
# Để trống nếu muốn khai báo trong ứng dụng: Bảo mật › Khai báo email OTP.
ADMIN_OTP_EMAIL=

# --- Dịch vụ gửi email: smtp hoặc resend ---
EMAIL_PROVIDER=smtp
# Địa chỉ người gửi (phải được nhà cung cấp email cho phép gửi)
MAIL_FROM="TAN HUNG HRM <no-reply@ten-mien-cua-ban.vn>"
# SMTP (Gmail/Google Workspace: smtp.gmail.com, 587, mật khẩu ứng dụng 16 ký tự)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true nếu dùng cổng 465 (TLS ngay từ đầu); false với 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Bắt buộc mã hóa STARTTLS (khuyến nghị giữ true)
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Resend (nếu EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# --- Tùy chọn ---
# Tự đăng xuất sau N phút không hoạt động (mặc định ban đầu; đổi được trong Bảo mật)
SESSION_IDLE_MINUTES=30
# Thời hạn tối đa của một phiên đăng nhập (giờ)
SESSION_MAX_HOURS=12
# Giới hạn đăng nhập sai: theo IP / toàn hệ thống trong cửa sổ thời gian, và thời gian khóa (phút)
LOGIN_MAX_FAILS_PER_IP=5
LOGIN_MAX_FAILS_GLOBAL=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# OTP: số lần nhập sai tối đa, thời gian chờ gửi lại (giây), số mã tối đa mỗi giờ
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Kết nối CSDL tối đa mỗi tiến trình (Vercel: 2, máy chủ riêng: 5)
PG_POOL_MAX=
# Chỉ cần khi máy chủ chạy sau reverse proxy (Nginx/Caddy) để lấy đúng IP người dùng. Vercel tự bật.
TRUST_PROXY=false
# Cổng cho chế độ máy chủ riêng (npm start)
PORT=3000
# Môi trường: production bật cookie Secure và HSTS (Vercel tự nhận là production)
NODE_ENV=production
